<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hpp_control</name>
  <version>2.0.1</version>
  <description>Simple Package to use hpp with the ros2_control JointTrajectoryController</description>
  <maintainer email="l.bernat@sileane.com">loan</maintainer>
  <license>Appache_2.0</license>

  <depend>hpp_interface</depend>
  
  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_copyright</test_depend>
